<%# app/views/sessions/new_register.html.erb %>
<div class="min-h-screen flex">
  <div class="hidden md:flex w-1/2">
    <%= image_tag "login-bg.jpg", class: "object-cover w-full h-full" %>
  </div>

  <div class="flex w-full md:w-1/2 items-center justify-center bg-pink-50">
    <div class="bg-white p-8 rounded-2xl shadow-lg border border-pink-200 w-96">
      <h1 class="text-3xl font-extrabold mb-6 text-pink-600 text-center">Register</h1>

      <% if flash[:alert].present? %>
        <p class="mb-4 text-sm text-pink-700"><%= flash[:alert] %></p>
      <% end %>

      <%= form_with model: @form, url: register_path, method: :post, local: true do |f| %>
        <div class="mb-3">
          <%= f.text_field :first_name,
                           placeholder: "First Name",
                           class: "w-full border rounded-md p-3 border-pink-500"
          %>
          <% @form.errors.full_messages_for(:first_name).each do |msg| %>
            <p class="text-xs text-pink-600 mt-1"><%= msg %></p>
          <% end %>
        </div>

        <div class="mb-3">
          <%= f.text_field :last_name, placeholder: "Last Name",
                           class: "w-full border rounded-md p-3 border-pink-500" %>
          <% @form.errors.full_messages_for(:last_name).each do |msg| %>
            <p class="text-xs text-pink-600 mt-1"><%= msg %></p>
          <% end %>
        </div>

        <div class="mb-3">
          <%= f.email_field :email, placeholder: "Email",
                            class: "w-full border rounded-md p-3 border-pink-500" %>
          <% @form.errors.full_messages_for(:email).each do |msg| %>
            <p class="text-xs text-pink-600 mt-1"><%= msg %></p>
          <% end %>
        </div>

        <div class="mb-6">
          <%= f.password_field :password, placeholder: "Password",
                               class: "w-full border rounded-md p-3 border-pink-500" %>
          <% @form.errors.full_messages_for(:password).each do |msg| %>
            <p class="text-xs text-pink-600 mt-1"><%= msg %></p>
          <% end %>
          <p class="text-xs text-gray-500 mt-1">
            Must be 8+ chars and include 1 uppercase, 1 digit, and 1 special (*,$@!%).
          </p>
        </div>

        <%= f.submit "Sign Up",
                     class: "w-full bg-pink-500 text-white py-2 rounded-lg shadow hover:bg-pink-600 transition" %>
      <% end %>

      <p class="mt-4 text-sm text-center text-gray-700">
        Already have an account?
        <%= link_to "Login", login_path, class: "text-pink-600 hover:underline" %>
      </p>
    </div>
  </div>
</div>
